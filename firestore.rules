rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for portfolio data
    match /profile/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "gulfamoffi62@gmail.com";
    }
    match /projects/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "gulfamoffi62@gmail.com";
    }
    match /experience/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "gulfamoffi62@gmail.com";
    }
    match /skills/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "gulfamoffi62@gmail.com";
    }
    match /workProcess/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "gulfamoffi62@gmail.com";
    }
    match /workstation/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "gulfamoffi62@gmail.com";
    }
    // Inquiries: anyone can write (contact form), only admin can read/delete
    match /inquiries/{doc} {
      allow create: if true;
      allow read, delete: if request.auth != null && request.auth.token.email == "gulfamoffi62@gmail.com";
    }
  }
}
